# 管理端对外访问配置
VITE_ADMIN_HOST=0.0.0.0
VITE_ADMIN_PORT=4000

# Vite 代理到后端。后端和管理端在同一台机器上时用 localhost。
# 如果后端部署在公网机器，可改成例如：http://106.54.18.117:5000
VITE_ADMIN_BACKEND_URL=http://localhost:5000

# 浏览器侧 API base。开发环境通常保持 /api，由 Vite proxy 转发。
VITE_ADMIN_API_BASE=/api

# 调试/演示时建议给长一点，避免大文件或慢查询误判失败。
VITE_ADMIN_PROXY_TIMEOUT_MS=120000
VITE_ADMIN_API_TIMEOUT_MS=120000
