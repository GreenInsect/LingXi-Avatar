# 对话模型 & 视觉语言模型（Qwen3-VL-8B-Instruct）
# 启动命令：
# python -m vllm.entrypoints.openai.api_server \
#     --model /home/hk/Qwen3-VL-8B-Instruct \
#     --served-model-name qwen3-vl \
#     --port 8001 \
#     --trust-remote-code \
#     --gpu-memory-utilization 0.5 \
#     --max-model-len 2048 \
#     --limit-mm-per-prompt '{"image": 1}' \
#     --enforce-eager
VLLM_CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-vl-max

VLLM_VL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VL_MODEL=qwen-vl-max

# 嵌入模型
# 启动命令：
# python -m vllm.entrypoints.openai.api_server     --model /home/hk/Qwen3-Embedding-0.6B     --port 8003     --gpu-memory-utilization 0.1     --max-model-len 512
VLLM_EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_MODEL_PATH=/var/tmp/Qwen3-Embedding-0.6B

DASHSCOPE_API_KEY=<your-dashscope-api-key>

# 数据库 
DATABASE_URL=sqlite:///./ai_guide.db

# 安全密钥 
SECRET_KEY=LinXiAIGuideSecretKey

# 存储目录 
KNOWLEDGE_BASE_DIR=./knowledge_base
CHROMA_DB_DIR=./chroma_db
UPLOAD_DIR=./uploads

# 语音合成 
TTS_PROVIDER=dashscope
TTS_MODEL=qwen-audio-3.0-tts-flash
TTS_VOICE=longanhuan_v3.6
TTS_INSTRUCTION=
# 华北2（北京）示例：wss://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api-ws/v1/inference
DASHSCOPE_TTS_WS_URL=wss://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api-ws/v1/inference

# 智能体参数 
MAX_HISTORY_TURNS=10
RAG_TOP_K=4
